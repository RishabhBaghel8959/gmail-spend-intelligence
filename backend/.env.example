# ---------------------------------------------------------------------------
# Gmail Spend Intelligence — backend environment
# Copy this file to `.env` (same folder) and fill in the values.
# NEVER commit your real .env — it is git-ignored.
# ---------------------------------------------------------------------------

# --- MongoDB -----------------------------------------------------------------
# Local MongoDB (default). The app connects here on startup and fails fast if
# it is not reachable.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=gmail_spend

# --- Google OAuth (required to connect a real Gmail account) -----------------
# Create an OAuth 2.0 "Web application" client at:
#   https://console.cloud.google.com/apis/credentials
# Enable the "Gmail API", and add this exact redirect URI to the client:
#   http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# --- Gemini LLM extraction (OPTIONAL) ----------------------------------------
# Leave GEMINI_API_KEY blank to use the built-in rule-based extractor only
# (works fully offline, no key required). Set it to also use Gemini for the
# harder emails. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Set MOCK_LLM=true to force the rule-based extractor even if a key is present.
MOCK_LLM=false

# --- Encryption --------------------------------------------------------------
# Fernet key used to encrypt the stored OAuth token at rest. If left blank, the
# app generates one and saves it to backend/.secrets/fernet.key on first run.
# To set your own, generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Sync limits / tuning ----------------------------------------------------
MAX_EMAILS=150
DEFAULT_MONTHS=6

# --- Local URLs (change only if you run on different ports) ------------------
FRONTEND_ORIGIN=http://localhost:8501
BACKEND_URL=http://localhost:8000
